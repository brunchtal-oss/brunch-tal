# ───────────────────────────────────────────────
# בראנץ׳ אצל טל: משתני סביבה
# מעתיקים ל-.env.local וממלאים. ב-Vercel ממלאים בדשבורד
# (Settings → Environment Variables), לכל סביבה בנפרד.
# אין כאן ערכים אמיתיים. ה-repo ציבורי.
# ───────────────────────────────────────────────

# Supabase (היום: פרויקט הפיתוח בלבד, עם נתונים בדויים)
# Dashboard → Project Settings → API Keys
# כתובת הפרויקט: https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# sb_publishable_... מותר בדפדפן
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# sb_secret_... בשרת בלבד. אסור לשים אותו במשתנה NEXT_PUBLIC_*
SUPABASE_SECRET_KEY=

# נעילת האתר עד ההשקה (Basic Auth ב-proxy.ts, AD-22)
# ב-Vercel (production ו-preview) האתר נעול תמיד, אלא אם SITE_LOCKED=false.
# במחשב המקומי הוא נעול רק כש-SITE_LOCKED=true.
# נעילה בלי שם משתמש או בלי סיסמה חוסמת את כולם.
# משתני שרת בלבד, אף פעם לא NEXT_PUBLIC_*.
# שם משתמש בלי נקודתיים (:). סיסמה אקראית של 20 תווים לפחות, באנגלית, ספרות וסימנים.
SITE_LOCKED=
SITE_LOCK_USER=
SITE_LOCK_PASSWORD=
