# ───────────────────────────────────────────────
# בראנץ׳ אצל טל: משתני סביבה
# מעתיקים ל-.env.local וממלאים. ב-Vercel ממלאים בדשבורד
# (Settings → Environment Variables), לכל סביבה בנפרד.
# אין כאן ערכים אמיתיים. ה-repo ציבורי.
# ───────────────────────────────────────────────

# Supabase (היום: פרויקט הפיתוח בלבד, עם נתונים בדויים)
# Dashboard → Project Settings → API Keys
# כתובת הפרויקט: https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# sb_publishable_... מותר בדפדפן
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# sb_secret_... בשרת בלבד. אסור לשים אותו במשתנה NEXT_PUBLIC_*
SUPABASE_SECRET_KEY=

# בדיקות המסד (npm run test:db) בלבד, מקומית. לא ב-Vercel ולא ב-CI.
# Dashboard → Connect → Session pooler (פורט 5432, לא 6543 של ה-transaction pooler):
# postgresql://postgres.<project-ref>:<password>@aws-...pooler.supabase.com:5432/postgres
# חייב להכיל את ה-ref של NEXT_PUBLIC_SUPABASE_URL, אחרת הבדיקות נעצרות לפני חיבור.
DEV_DATABASE_URL=

# נעילת האתר עד ההשקה (Basic Auth ב-proxy.ts, AD-22)
# ב-Vercel (production ו-preview) האתר נעול תמיד, אלא אם SITE_LOCKED=false.
# במחשב המקומי הוא נעול רק כש-SITE_LOCKED=true.
# נעילה בלי שם משתמש או בלי סיסמה חוסמת את כולם.
# משתני שרת בלבד, אף פעם לא NEXT_PUBLIC_*.
# שם משתמש בלי נקודתיים (:). סיסמה אקראית של 20 תווים לפחות, באנגלית, ספרות וסימנים.
SITE_LOCKED=
SITE_LOCK_USER=
SITE_LOCK_PASSWORD=

# פוש (סיפור 5.8, AD-11, AD-12). זוג VAPID אחד לכל פרויקט Supabase, זהה במחשב
# ובכל סביבת Vercel שמחוברת אליו: npx web-push generate-vapid-keys --json
# המפתח הציבורי מותר בדפדפן (נכנס לקוד בזמן ה-build, ולכן אחרי שינוי פורסים מחדש).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# בשרת בלבד.
VAPID_PRIVATE_KEY=
# mailto: של העסק (או https://). ערך לא תקין: Apple דוחה ב-403 והעובד מחזיר 503.
VAPID_SUBJECT=
# הסוד של /api/jobs/push (Bearer). זהה ל-cron_secret ב-Vault של Supabase. בשרת בלבד.
# node -p "require('crypto').randomBytes(32).toString('base64url')"
CRON_SECRET=
